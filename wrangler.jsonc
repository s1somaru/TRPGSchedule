{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trpg-schedule",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-10-01",

  // 画面のファイル(Vite で作ったもの)。/api だけ Worker のコードに通す
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // データの保存先。database_id / id は本番用を作ったときに書き換える(手元の開発では使われない)
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "trpg-schedule",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    { "binding": "SHARE_TOKENS", "id": "00000000000000000000000000000000" }
  ],

  // 回数制限(IPごと・1分あたり)
  "ratelimits": [
    { "name": "RL_CREATE", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_TOKEN", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_WRITE", "namespace_id": "1003", "simple": { "limit": 60, "period": 60 } }
  ],

  "observability": { "enabled": true }
}
