{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "takuyose",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-10-01",

  // 公開のスイッチ。true で https://takuyose.s1somaru.workers.dev から開ける
  // (false にしてデプロイし直すと、Cloudflare に置いたまま外からは開けなくなる)
  "workers_dev": true,
  "preview_urls": false,

  // 画面のファイル(Vite で作ったもの)。画像・JS・CSS(「!」の付いたもの)は Cloudflare が直接返し、
  // それ以外(画面のページと /api)は Worker のコードに通す。
  // ページを通すのは、http で開かれたら https に飛ばすため(workers.dev では Cloudflare の設定でできない)と、
  // 卓ページで URL を貼ったときのカードに卓のタイトルを入れるため(spec.md 3.21・7.5)
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/*", "!/assets/*", "!/brand/*", "!/favicon.png", "!/apple-touch-icon.png", "!/og-image.png"]
  },

  // データの保存先(本番はアジア太平洋に作成。手元の開発では、この ID の DB は使われず手元の DB を使う)
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "takuyose",
      "database_id": "fe596a95-3efe-4e72-8180-e9b3045360fd",
      "migrations_dir": "migrations"
    }
  ],

  // 回数制限(接続元ごと・1分あたり。IPv6 は先頭64ビットごと)
  "ratelimits": [
    { "name": "RL_CREATE", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_WRITE", "namespace_id": "1003", "simple": { "limit": 60, "period": 60 } },
    { "name": "RL_READ", "namespace_id": "1004", "simple": { "limit": 120, "period": 60 } }
  ],

  // 毎日の定期処理。UTC 18時 = 日本時間の朝3時
  "triggers": { "crons": ["0 18 * * *"] },

  // ログ。アプリが出すログ(エラーの種類・定期処理の件数)だけを残す。
  // Cloudflare が自動で残すリクエストごとの記録は切る(秘密が入った Authorization ヘッダを残さないため)
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false }
  }
}
