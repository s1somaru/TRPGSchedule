{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "takuyose",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-10-01",

  // 画面のファイル(Vite で作ったもの)。/api だけ Worker のコードに通す
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // データの保存先。database_id は本番用を作ったときに書き換える(手元の開発では使われない)
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "takuyose",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  // 回数制限(接続元ごと・1分あたり。IPv6 は先頭64ビットごと)
  "ratelimits": [
    { "name": "RL_CREATE", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_WRITE", "namespace_id": "1003", "simple": { "limit": 60, "period": 60 } },
    { "name": "RL_READ", "namespace_id": "1004", "simple": { "limit": 120, "period": 60 } }
  ],

  // 毎日の定期処理。UTC 18時 = 日本時間の朝3時
  "triggers": { "crons": ["0 18 * * *"] },

  // ログ。アプリが出すログ(エラーの種類・定期処理の件数)だけを残す。
  // Cloudflare が自動で残すリクエストごとの記録は切る(秘密が入った Authorization ヘッダを残さないため)
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false }
  }
}
